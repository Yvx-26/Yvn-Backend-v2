# 首次使用时将本文件复制为 .env，再填写真实连接信息。
# 后端启动时会自动读取 .env；.env 已被 Git 忽略，不要提交真实密码。
# PowerShell 的 $env: 或部署平台变量可以临时覆盖本文件中的同名配置。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_DATABASE=emqx
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=10
DB_WRITE_TIMEOUT_SECONDS=10

# 后端主动连接 EMQX。生产环境按实际 Broker 信息填写。
MQTT_BRIDGE_ENABLED=true
MQTT_BROKER_HOST=your-emqx-host
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# 必须与 DTU 的 Client ID 不同，避免把 DTU 顶下线。
MQTT_CLIENT_ID=tdr_local_backend

# EMQX 规则把原始消息补充/整理成 JSON 后，重新发布到这两个后端专用 Topic。
# backend/wave 中的每条消息都必须携带原发布者 clientid，因此不再配置固定的
# MQTT_SOURCE_CLIENTID，也就可以同时区分多个 DTU 设备。
MQTT_WAVE_TOPIC=backend/wave
MQTT_GPS_TOPIC=backend/gps

# MQTT Bridge 将消息交给同一 FastAPI 进程的入库接口。
MQTT_LOCAL_BACKEND_URL=http://127.0.0.1:8000

# 启用新版 Bridge 前先人工执行 migrations/ingestion_receipts.sql。
# 本地队列必须位于可持久化、可写的本地磁盘，不能在部署时删除。
MQTT_INBOX_PATH=var/mqtt-inbox.sqlite3
MQTT_INBOX_MAX_PENDING=10000
MQTT_MAX_MESSAGE_BYTES=262144
MQTT_RETRY_MAX_ATTEMPTS=10
MQTT_DONE_RETENTION_DAYS=7
